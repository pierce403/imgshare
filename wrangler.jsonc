{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imgshare",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "build/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "AUTH_DOMAIN": "imgshare.app",
    "READ_ONLY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imgshare-production",
      "database_id": "f915a324-2cf4-44c1-bfd6-72aaab7c44b4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "imgshare-staging",
      "routes": [],
      "preview_urls": false,
      "vars": {
        "AUTH_DOMAIN": "imgshare-staging.bcrt43.workers.dev",
        "READ_ONLY": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imgshare-staging",
          "database_id": "867648f0-2455-4b05-b2ef-2159ff80d0a8",
          "migrations_dir": "migrations"
        }
      ]
    }
  },
  "routes": [
    {
      "pattern": "imgshare.app/*",
      "zone_name": "imgshare.app"
    }
  ]
}
